exports[`extractJSONString > DEL removed 1`] = `"{"a":"xy"}"`;

exports[`extractJSONString > bare fence 1`] = `"{"a":1}"`;

exports[`extractJSONString > bom 1`] = `"{"a":1}"`;

exports[`extractJSONString > control characters removed, newline and tab kept 1`] = `
"{"a":"xyz
	"}"
`;

exports[`extractJSONString > empty 1`] = `""`;

exports[`extractJSONString > json fence 1`] = `"{"a":1}"`;

exports[`extractJSONString > low and prime quotes 1`] = `"{"a":"" x " " " ' ' ' '"}"`;

exports[`extractJSONString > no braces at all 1`] = `"no json here"`;

exports[`extractJSONString > only closing brace before opening 1`] = `"} text {"`;

exports[`extractJSONString > plain 1`] = `"{"a":1}"`;

exports[`extractJSONString > single opening brace 1`] = `"{ never closed"`;

exports[`extractJSONString > smart double quotes inside a valid string (quirk: corrupts valid JSON) 1`] = `"{"a":"He said "hello""}"`;

exports[`extractJSONString > smart quotes used as JSON delimiters 1`] = `"{"a": "b"}"`;

exports[`extractJSONString > smart single quotes become straight apostrophes 1`] = `"{"a":"it's 'fine'"}"`;

exports[`extractJSONString > text around the object 1`] = `"{"a":1}"`;

exports[`extractJSONString > two objects: first brace to last brace 1`] = `"{"a":1} {"b":2}"`;

exports[`extractJSONString > upper-case JSON fence 1`] = `"{"a":1}"`;

